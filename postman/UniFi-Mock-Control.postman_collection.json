            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{controlBase}}/faults",
                    "host": [
                        "{{controlBase}}"
                    ],
                    "path": [
                        "faults"
                    ]
                },
                "description": "`match` is \"METHOD path-glob\" on the path after the connector base (`*` matches anything). `status` 400–599, `times` ≥ 1, optional `delayMs` (capped) and `timeout`. Integration routes only.",
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"match\": \"GET */hotspot/vouchers\",\n    \"status\": 429,\n    \"times\": 2\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            }
        },
