APP_NAME="UniFi Network Mock"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8091

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- The mock -------------------------------------------------------------
# Any local value. The integration collection sends it as X-API-KEY.
# Never put the real UniFi key here.
UNIFI_MOCK_API_KEY=local-dev-key
UNIFI_MOCK_CONSOLE_ID=mock-console
UNIFI_MOCK_APP_VERSION=9.1.0
# D2: unknown type/action values are accepted with a warning unless strict.
UNIFI_MOCK_STRICT=false
# G11: optional fields with no value are omitted (omit) or returned as null (null).
UNIFI_MOCK_OPTIONAL_FIELDS=omit
UNIFI_MOCK_MAX_DELAY_MS=30000
UNIFI_MOCK_LOG_KEEP=500
