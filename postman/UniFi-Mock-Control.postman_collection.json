{
    "info": {
        "name": "UniFi Mock — Control plane",
        "description": "The mock-only /__mock control plane. Not part of UniFi; needs no X-API-KEY; answers 404 when APP_ENV=production. Generated by `php artisan mock:build-control-collection`.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Reset to a scenario",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status 200', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{controlBase}}/reset?seed=default",
                    "host": [
                        "{{controlBase}}"
                    ],
                    "path": [
                        "reset"
                    ],
                    "query": [
                        {
                            "key": "seed",
                            "value": "default"
                        }
                    ]
                },
                "description": "Replaces all state with `default`, `empty`, `multi-site` or `large`, resets the clock to real time, clears faults and restores default settings."
            }
        },
        {
            "name": "Read the full state",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status 200', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{controlBase}}/state",
                    "host": [
                        "{{controlBase}}"
                    ],
                    "path": [
                        "state"
                    ]
                },
                "description": "Clock, strict mode, optional-field mode, faults and every stored resource."
            }
        },
        {
